rules_version = '2';

// 모든 Firestore 읽기/쓰기는 backend/(Firebase Admin SDK, 서버 권한)를 통해서만 이뤄진다.
// 클라이언트(Firebase Client SDK)가 Firestore에 직접 접근하는 경로는 없으므로 전부 차단한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
