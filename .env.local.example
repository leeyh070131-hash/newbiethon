# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채운다. .env.local은 git에 올리지 않는다.

# --- 백엔드 (Firebase Admin SDK) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 에서 발급
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 프론트엔드 (Firebase Client SDK, Codex 담당) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 에서 발급
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 서울 열린데이터광장 일반 API 키 (현재 미사용. 버스정류소 API에는 못 씀 — backend/data/README.md 참고) ---
SEOUL_OPENAPI_KEY=

# --- 성북구 버스정류장 데이터 (아직 미확보, backend/data/README.md 참고) ---
# data.go.kr에서 "서울특별시_정류소정보조회 서비스" 신청 후 채운다.
DATA_GO_KR_SERVICE_KEY=

# --- 출발시간 임박 처리 크론(app/api/cron/check-departures) 인증 ---
# 아무 임의의 긴 문자열이나 생성해서 넣는다(예: openssl rand -hex 32).
# Vercel에 같은 값을 환경변수로 등록하면 Vercel Cron이 자동으로 Authorization 헤더에 붙여 보낸다.
CRON_SECRET=
