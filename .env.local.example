# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채운다. .env.local은 git에 올리지 않는다.

# --- 백엔드 (Firebase Admin SDK) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 에서 발급
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 프론트엔드 (Firebase Client SDK, Codex 담당) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 에서 발급
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 성북구 버스정류장 데이터 (아직 미사용, backend/data/README.md 참고) ---
SEOUL_OPENAPI_KEY=
